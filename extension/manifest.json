{
  "manifest_version": 3,
  "name": "Flaneur",
  "version": "0.3.0",
  "description": "Save selected LinkedIn profiles, posts and web pages to your private Flaneur memory.",
  "permissions": [
    "contextMenus",
    "storage",
    "alarms",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Save this page to Flaneur"
  }
}
