{
  "name": "flaneur-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "worker:parse": "node scripts/processing/run.mjs",
    "auth:setup": "node scripts/auth/setup-owner.mjs",
    "auth:status": "node scripts/auth/status-owner.mjs",
    "dev": "next dev",
    "build:ext": "npm run ext:build && node scripts/pack-extension.mjs",
    "build": "npm run build:ext && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/database/migrate.mjs",
    "db:check": "node scripts/database/preflight.mjs",
    "db:validate": "node scripts/database/validate.mjs",
    "reparse": "node scripts/run-ts.mjs scripts/reparse.ts",
    "reenrich": "node scripts/run-ts.mjs scripts/reenrich.ts",
    "test-search": "node scripts/run-ts.mjs scripts/test-search.ts",
    "ext:build": "node extension/build.mjs",
    "ext:watch": "node extension/build.mjs --watch",
    "ext:typecheck": "tsc --noEmit -p extension"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "linkedom": "^0.18.13",
    "next": "^16.3.6",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "adm-zip": "^0.6.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
